{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/schemas/mailbox-successor-binding-v1.schema.json",
  "title": "Atlas Mailbox Successor Binding v1",
  "description": "Correlation from a validated 001A/001B result route to a read-only governor WorkNode. Not authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "package_id", "message_id", "incident_id", "source_task_id",
    "source_attempt_id", "source_result_digest", "route_digest", "correlation_id",
    "causation_id", "requester_id", "trusted_main", "trusted_tree", "candidate_head",
    "candidate_tree", "task_type", "transition", "execution_host_class",
    "required_capabilities", "authority_reference", "owner_gate", "execution_authorized",
    "merge_authorized", "production_mutation_authorized", "binding_digest"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "package_id": { "$ref": "#/$defs/id" },
    "message_id": { "$ref": "#/$defs/id" },
    "incident_id": { "$ref": "#/$defs/id" },
    "source_task_id": { "$ref": "#/$defs/id" },
    "source_attempt_id": { "$ref": "#/$defs/id" },
    "source_result_digest": { "$ref": "#/$defs/sha256" },
    "route_digest": { "$ref": "#/$defs/sha256" },
    "correlation_id": { "$ref": "#/$defs/id" },
    "causation_id": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "requester_id": { "$ref": "#/$defs/id" },
    "trusted_main": { "$ref": "#/$defs/gitObjectId" },
    "trusted_tree": { "$ref": "#/$defs/gitObjectId" },
    "candidate_head": { "anyOf": [{ "$ref": "#/$defs/gitObjectId" }, { "type": "null" }] },
    "candidate_tree": { "anyOf": [{ "$ref": "#/$defs/gitObjectId" }, { "type": "null" }] },
    "task_type": { "enum": ["candidate_verification", "recertification", "program_reconciliation"] },
    "transition": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
    "execution_host_class": { "const": "EXTERNAL_AGENT" },
    "required_capabilities": {
      "type": "array", "minItems": 1, "maxItems": 2,
      "items": { "enum": ["DISCOVER", "VERIFY"] }, "uniqueItems": true
    },
    "authority_reference": { "$ref": "#/$defs/id" },
    "owner_gate": { "const": false },
    "execution_authorized": { "const": false },
    "merge_authorized": { "const": false },
    "production_mutation_authorized": { "const": false },
    "binding_digest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "gitObjectId": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
