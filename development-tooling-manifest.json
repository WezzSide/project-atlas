{
  "repository": "B0LK13/project-atlas",
  "platforms": [
    "linux",
    "windows"
  ],
  "items": [
    {
      "name": "codebase-memory-mcp",
      "version": "0.10.8",
      "kind": "mcp",
      "source": "npm",
      "required": true,
      "platform": [
        "linux",
        "windows"
      ],
      "install_method": {
        "linux": "npm i -g codebase-memory-mcp@0.10.8",
        "windows": "npm i -g codebase-memory-mcp@0.10.8"
      },
      "config_locations": {
        "linux": [
          "$HOME/.copilot/mcp-config.json",
          "$HOME/.config/Code/User/mcp.json",
          "$HOME/.cursor/mcp.json"
        ],
        "windows": [
          "$env:USERPROFILE\\.copilot\\mcp-config.json",
          "$env:APPDATA\\Code\\User\\mcp.json",
          "$env:USERPROFILE\\.cursor\\mcp.json"
        ]
      },
      "security_scope": "user",
      "health_command": "codebase-memory-mcp --version",
      "purpose": "Persistent code graph intelligence and architecture discovery."
    },
    {
      "name": "github-mcp-server",
      "version": "1.12.0",
      "kind": "mcp",
      "source": "npm+wrapper",
      "required": true,
      "platform": [
        "linux",
        "windows"
      ],
      "install_method": {
        "linux": "npm i -g github-mcp-server@1.12.0 and wrapper with runtime-auth gh token indirection.",
        "windows": "npm i -g github-mcp-server@1.12.0 and PowerShell wrapper with runtime-auth gh token indirection."
      },
      "config_locations": {
        "linux": [
          "$HOME/.local/bin/github-mcp-wrapper",
          "$HOME/.copilot/mcp-config.json",
          "$HOME/.config/Code/User/mcp.json",
          "$HOME/.cursor/mcp.json"
        ],
        "windows": [
          "$env:USERPROFILE\\.local\\bin\\github-mcp-wrapper.ps1",
          "$env:USERPROFILE\\.copilot\\mcp-config.json",
          "$env:APPDATA\\Code\\User\\mcp.json",
          "$env:USERPROFILE\\.cursor\\mcp.json"
        ]
      },
      "security_scope": "runtime-token-only",
      "health_command": "github-mcp-server --version",
      "purpose": "Repository metadata, PR, issue, commit, and CI truth."
    },
    {
      "name": "@playwright/mcp",
      "version": "0.0.80",
      "kind": "mcp",
      "source": "npm",
      "required": true,
      "platform": [
        "linux",
        "windows"
      ],
      "install_method": {
        "linux": "npm i -g @playwright/mcp@0.0.80",
        "windows": "npm i -g @playwright/mcp@0.0.80"
      },
      "config_locations": {
        "linux": [
          "$HOME/.copilot/mcp-config.json",
          "$HOME/.config/Code/User/mcp.json",
          "$HOME/.cursor/mcp.json"
        ],
        "windows": [
          "$env:USERPROFILE\\.copilot\\mcp-config.json",
          "$env:APPDATA\\Code\\User\\mcp.json",
          "$env:USERPROFILE\\.cursor\\mcp.json"
        ]
      },
      "security_scope": "headless-browser-automation",
      "health_command": "npx -y @playwright/mcp@0.0.80 --help",
      "purpose": "Browser automation for UI/evidence verification."
    },
    {
      "name": "@upstash/context7-mcp",
      "version": "4.0.5",
