# The following are deliberately synthetic security fixtures used by tests.
!atlas-vault-documentation/tests/fixtures/project-atlas/credentials.json
!atlas-vault-documentation/tests/fixtures/projects/mixed-formats/.env
!atlas-vault-documentation/tests/fixtures/projects/mixed-formats/credentials.json
!atlas-vault-documentation/tests/fixtures/projects/mixed-formats/secrets.pem

# OS metadata
.DS_Store
Thumbs.db
desktop.ini

# Windsurf plans and session state
.windsurf/

# Local WSL validation venv (artifact-closure worktree)
.venv-wsl/

# Root agent spool (local session residue; do not ignore tracked `.atlas/project.yaml`)
.atlas-spool/

# AS-CODER-ALPHA-CONNECT-001 local dogfood bind + in-tree default vault
.atlas-vault/
.atlas/connect.json
**/.atlas-vault/
**/.atlas/connect.json
# Root marker is tracked as project-atlas identity; ignore accidental
# connect-generated markers only under nested workdirs if present.
**/.atlas/connect-bind.json

# AS-ORCH-001C ephemeral Cursor bridge state (runtime only; never commit)
.atlas/orchestration/
**/.atlas/orchestration/

# AS-2.2-EVAL-001 private holdout expected map (never commit plaintext answers).
# Documented operator-local location (docs/AS-2.2-EVAL-001.md,
# fixtures/eval/holdouts/hidden/ACCESS.md):
fixtures/eval/holdouts/private/
# Defense in depth: ignore any eval/holdout expected-answer map wherever it
# lands so a stray private key (e.g. eval_holdout_expected.json) can never be
# committed as plaintext again (W2: HIDDEN_HOLDOUT_ISOLATION leak).
**/*eval*expected*.json
**/*holdout*expected*.json

# AS-IMPR-PLANE local outcome annotations (non-authoritative)
.atlas/improvement-plane/
