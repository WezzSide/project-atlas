[Unit]
Description=Atlas Runner Fabric worker-network firewall permit (AS-RUNNER-FABRIC-001)
Documentation=file:/opt/atlas-runner/current/docs/SECURITY.md
After=docker.service atlas-docker-guard.service
Requires=docker.service
ConditionPathExists=/usr/local/sbin/atlas-runner-firewall

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/atlas-runner-firewall
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true

[Install]
WantedBy=multi-user.target
