[Unit]
Description=Atlas Runner Fabric controller (AS-RUNNER-FABRIC-001)
Documentation=file:/opt/atlas-runner/current/README.md
After=docker.service network-online.target
Wants=docker.service

[Service]
Type=simple
User=atlas-runner
Group=atlas-runner
WorkingDirectory=/opt/atlas-runner/current
ExecStart=/opt/atlas-runner/current/bin/atlas-runner run --config /etc/atlas-runner/config/atlas-runner.toml
EnvironmentFile=-/etc/atlas-runner/config/atlas-runner.env
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=5

# Hardening (AF_UNIX is required for the docker CLI socket).
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/atlas-runner /var/log/atlas-runner
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
DeviceAllow=/dev/null rw
SystemCallArchitectures=native

# Evidence for the hardening posture:
#   systemd-analyze security atlas-runner-controller.service

[Install]
WantedBy=multi-user.target
